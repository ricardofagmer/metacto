# Reference list of environment variable names. Neither app loads a .env file:
# export the ones you need in your shell (for example `export GEMINI_API_KEY=...`).
# Never commit real values.
#
# API (apps/api). All variables are optional; documented defaults are in comments.

# Unset -> HeuristicProvider (no network). Set -> GeminiProvider.
GEMINI_API_KEY=
# Default: gemini-2.5-flash
GEMINI_MODEL=
# Unset -> SQLite file ./data/fis.sqlite. A postgres:// URL switches the driver.
DATABASE_URL=
# Default: 3001
PORT=
# CORS allow-origin. Default: http://localhost:3000
WEB_ORIGIN=

# Web (apps/web). Default: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=

# Rate limiting and AI cost control (apps/api). Defaults shown.
# Per-IP fixed window in seconds, global limit, and strict limit for submit and AI endpoints.
THROTTLE_WINDOW_SECONDS=
THROTTLE_LIMIT=
THROTTLE_STRICT_LIMIT=
# Daily Gemini call budget; 0 disables the Gemini path (heuristic is used instead). Default: 500
AI_DAILY_CALL_BUDGET=
